# ─── مدار (MADAR) — Environment Variables ───────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Core ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_DOMAIN=madar.app
PUBLIC_SITE_BASE_URL=https://madar.app

# --- Database (MySQL) ---
DATABASE_URL=mysql://madar_user:change_me@localhost:3306/madar_db

# --- Redis (optional; shared rate-limit store) ---
REDIS_URL=redis://localhost:6379

# --- Sessions (REQUIRED) ---
# openssl rand -hex 32
JWT_SECRET=

# Promote this openId or email to admin on first sign-in
OWNER_OPEN_ID=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,https://madar.app,https://*.madar.app

# --- S3-compatible storage (REQUIRED for media uploads) ---
# Works with AWS S3, Cloudflare R2, MinIO, etc.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public CDN / bucket URL if objects are publicly readable
S3_PUBLIC_BASE_URL=

# --- Optional Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Manual payment model ---
# Binance settings are stored securely in platform_settings and managed by Admin.
# No Stripe credentials are required for MADAR marketplace purchases.

# --- Telegram outbound notifications (optional) ---
# Bot sends notifications only. No polling, commands or webhook is used.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Netlify production ---
# Set APP_URL to your Netlify/custom domain and ALLOWED_ORIGINS to the same origin(s).
# Netlify Functions require an external MySQL-compatible database and S3-compatible storage.
